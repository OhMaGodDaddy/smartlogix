# SmartLogix Frontend Environment Variables Template (Vite)
# NOTE: All variables accessed in Vite MUST begin with VITE_

# Base API Gateway URL
VITE_API_BASE_URL=https://api.smartlogix.org

# Backend Microservices Endpoints
VITE_AUTH_SERVICE_URL=https://auth.api.smartlogix.org
VITE_INVENTORY_SERVICE_URL=https://inventory.api.smartlogix.org
VITE_VEHICLE_SERVICE_URL=https://vehicle.api.smartlogix.org
VITE_NOTIFICATION_SERVICE_URL=https://notification.api.smartlogix.org

# Optional Analytics & Feature Flags
VITE_ENABLE_MOCK_FALLBACK=true
